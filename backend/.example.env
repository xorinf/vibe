# Environment
NODE_ENV="production"
APP_PORT="3141"
APP_MODULE="auth"

# App
APP_URL="http://localhost:3141"
APP_ORIGINS="http://localhost:3141"

# Database
DB_URL="mongodb+srv://<username>:<password>@<remaining URI>"
DB_NAME="vibe"
MONGOMS_DEBUG="true"

# Firebase Emulators
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
FIREBASE_EMULATOR_HOST="127.0.0.1:4000"
GCLOUD_PROJECT="example-project-id"

# ── Crowd-question screening filter (studentQuestions) ──
# Provider for the AI screening judge: 'groq' (free-tier demo) or 'anthropic' (prod).
SCREENING_PROVIDER=groq
SCREENING_ENABLED=true
# Context (lesson-relevance) checking — ON HOLD until real transcripts exist.
# When true, feeds lesson context to the on-topic gate + answer-correctness check.
SCREENING_CONTEXT_ENABLED=false
# Groq (free key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Anthropic (prod) reuses ANTHROPIC_CRED / ANTHROPIC_MODEL above.
SCREENING_TIMEOUT_MS=9000
SCREENING_MAX_RETRIES=2
SCREENING_DEDUP_LIMIT=50
SCREENING_CONTEXT_CHARS=2000

# ── Uploaded video / HLS streaming (media module) ──
# Teachers upload straight to the upload bucket via a signed URL; a cloud
# transcoder writes an HLS ladder into the stream bucket. ViBe only signs URLs.
#
# ⚠️ Set GOOGLE_VIDEO_PROJECT_ID, NOT GCLOUD_PROJECT, when the video buckets live
# in a different GCP project from Firebase. The Firebase Admin SDK reads
# GCLOUD_PROJECT to decide which project to verify ID tokens against, so pointing
# that at the video project makes every authenticated request fail with
# 'Firebase ID token has incorrect "aud" (audience) claim'.
GOOGLE_VIDEO_PROJECT_ID=
GOOGLE_VIDEO_UPLOAD_BUCKET=vibe-video-uploads
GOOGLE_VIDEO_STREAM_BUCKET=vibe-video-streams
# Lifetime of an issued upload URL (minutes). One hour covers a large file.
VIDEO_UPLOAD_URL_TTL_MINUTES=60
# Lifetime of a playback URL (minutes). HLS re-requests segments for the whole
# session, so this must outlast the longest expected watch or playback stalls
# mid-lesson. Moving to CDN signed cookies removes this constraint.
VIDEO_PLAYBACK_URL_TTL_MINUTES=360
# Largest upload we will issue a URL for (bytes). Default 2 GiB.
# Enforced server-side from the sizeBytes the client reports, which is required for
# that reason. The upload dialog checks the same limit first, for faster feedback.
VIDEO_MAX_UPLOAD_BYTES=2147483648
# Cloud CDN in front of the stream bucket. Set the host to serve playback through
# the CDN (cached at the edge) instead of the storage API.
GOOGLE_VIDEO_CDN_HOST=
# Use http only while the load balancer's certificate is still provisioning; an
# http media URL is blocked as mixed content on an https frontend.
GOOGLE_VIDEO_CDN_SCHEME=https
# CDN signed-URL key. GCP will not reveal the value after creation, so capture it
# when running `gcloud compute backend-buckets add-signed-url-key`.
# Without these, CDN playback URLs are UNSIGNED and only work while the stream
# bucket allows public read — a temporary state, not a supported mode.
GOOGLE_VIDEO_CDN_KEY_NAME=
GOOGLE_VIDEO_CDN_KEY_VALUE=

# ── Interactive Learning Experience (ILE) ────────────────────────────────
# The ILE module is opt-in. None of these vars are required to boot, but
# defaults are tuned for local dev. Override per environment.

# At-rest encryption of per-owner AI API keys (see ILE repo Keystore).
#   ILE_KEY_PROVIDER=local   → AES-256-GCM via ILE_LOCAL_KEK (default; dev)
#   ILE_KEY_PROVIDER=kms     → wire KmsKeyProvider against your KMS (prod)
#   ILE_KEY_PROVIDER=none    → plaintext storage. NEVER use in production.
ILE_KEY_PROVIDER=local
# 32-byte (64 hex char) Key Encryption Key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When unset, an ephemeral key is generated at process start — saved secrets
# will NOT survive a backend restart, which is the desired forced-migration
# signal for dev. SET THIS BEFORE GOING TO PROD.
ILE_LOCAL_KEK=

# Upstream LLM provider deadline for generate/edit/from-context streams.
# Fires a ProviderTimeoutError → SSE 'error' event of kind 'timeout'.
# Raise for slow models (MiniMax M3, large-context completions); lower to
# fail fast on dead streams.
ILE_UPSTREAM_TIMEOUT_MS=120000

# ── YouTube context provider (used when a teacher pastes a YouTube URL) ─
# Comma-separated language codes tried in order for the auto-captions
# strategy. Append codes for languages you actually teach; the teacher
# cannot change this from the UI. Changing this requires a backend restart.
ILE_YT_AUTO_LANGS=en,en-US,en-GB,es,fr,de

# ── Whisper fallback (used only when both caption strategies fail) ───────
# Optional: when yt-dlp AND faster-whisper are installed, ILE will
# transcribe the video locally and pass the result to the LLM. Without
# them, the provider chain falls back to "captions-only" with a friendly
# install hint. See README for platform install steps.
ILE_WHISPER_MODEL=small              # tiny | base | small | medium | large-v3
ILE_WHISPER_TIMEOUT_MS=600000        # 10 min hard cap per transcript
ILE_WHISPER_BIN=python3              # python interpreter that imports faster_whisper
ILE_WHISPER_DEVICE=cpu               # cpu | cuda
# int8 on cpu, float16 on cuda; override only if you know what you're doing.
# ILE_WHISPER_COMPUTE_TYPE=

# ── Asset uploads per teacher ───────────────────────────────────────────
# Default 500 MB per owner across all asset kinds (image/audio/video/pdf/svg).
# Override per-deployment; the limit is checked on every upload.
ILE_OWNER_QUOTA_BYTES=524288000
